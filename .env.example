MEMORY_DB=/mnt/sdc/zhaoyifan/AgentMemory/competition_v1/data/competition.db

# Alibaba Cloud Model Studio
DASHSCOPE_API_KEY=replace_me
DASHSCOPE_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024

# OpenAI official API
OPENAI_API_KEY=replace_me
OPENAI_BASE_URL=https://api.openai.com/v1
MEMORY_LLM_MODEL=gpt-4o-mini

# Local reranker
RERANKER_MODEL=/mnt/sdc/zhaoyifan/AgentMemory/models/Qwen3-Reranker-4B
RERANKER_DEVICE=cuda:0
RERANKER_BATCH_SIZE=4
RERANKER_MAX_LENGTH=8192

# API authentication
MEMORY_SYSTEM_KEY=replace_with_a_long_random_key